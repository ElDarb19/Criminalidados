{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('lobby/hostUid').val() === auth.uid",
        "lobby": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
          "players": {
            "$slot": {
              ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || root.child('rooms').child($roomId).child('lobby').child('hostUid').val() === auth.uid)"
            }
          }
        },
        "play": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('lobby').child('hostUid').val() === auth.uid",
          "actions": {
            "$actionId": {
              ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || root.child('rooms').child($roomId).child('lobby').child('hostUid').val() === auth.uid)"
            }
          },
          "presence": {
            "$slot": {
              ".write": "auth != null && root.child('rooms').child($roomId).child('lobby').child('players').child($slot).child('uid').val() === auth.uid"
            }
          }
        }
      }
    }
  }
}
